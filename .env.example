# Server Configuration
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (MongoDB connection string)
MONGO_URI=mongodb://127.0.0.1:27017/production-ready-backend-api

# JWT Authentication
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_here
REFRESH_TOKEN_EXPIRY=10d

# Email Service (Mailtrap or any SMTP provider)
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=your_mailtrap_user
MAILTRAP_SMTP_PASS=your_mailtrap_pass
